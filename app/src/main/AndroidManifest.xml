<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Smart Pantry Manager stores everything in a local SQLite database, so the app
        declares NO permissions at all. In particular there is no INTERNET, no
        ACCESS_FINE_LOCATION and no mapping SDK anywhere in the project, as required
        by Section 2.3 / 3.3 of the assignment brief.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <!-- Screen 1: pantry list (launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: add / edit a pantry ingredient -->
        <activity
            android:name=".AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: suggested recipes (strict matching) -->
        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested" />

        <!-- Screen 4: full recipe book -->
        <activity
            android:name=".RecipeBrowseActivity"
            android:exported="false"
            android:label="@string/title_recipes" />

        <!-- Screen 5: recipe detail -->
        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".SuggestedRecipesActivity" />

        <!-- Screen 6: settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />
    </application>

</manifest>
