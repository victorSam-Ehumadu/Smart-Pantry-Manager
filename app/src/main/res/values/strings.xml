    <string name="dialog_clear_pantry_title">Clear the pantry?</string>

    <plurals name="dialog_clear_pantry_message">
        <item quantity="one">This deletes %1$d ingredient and cannot be undone.</item>
        <item quantity="other">This deletes all %1$d ingredients and cannot be undone.</item>
    </plurals>

    <string name="dialog_restore_recipes_title">Restore the recipe book?</string>
    <string name="dialog_restore_recipes_message">The 20 bundled recipes will be written again. Your pantry is not touched.</string>
    <string name="dialog_rule_title">How suggestions are chosen</string>
    <string name="dialog_rule_message">A recipe is only suggested when EVERY ingredient it needs is already in your pantry, in at least the required amount.\n\nIf a recipe needs five ingredients and you have four, it will not appear here — no shopping trip should be needed for anything on this list.\n\nNames are matched flexibly, so \"tomatoes\" matches \"tomato\", and units are converted, so 500 g covers 0.5 kg.\n\nThe \"Almost There\" section below is kept separate on purpose: those recipes are one ingredient short and are not suggestions.</string>

