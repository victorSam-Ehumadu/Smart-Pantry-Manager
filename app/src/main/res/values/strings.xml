    <!-- ============================== Dialogs =============================== -->
    <string name="dialog_delete_title">Delete this item?</string>
    <string name="dialog_delete_message">%1$s will be removed from your pantry.</string>
    <string name="dialog_duplicate_title">Already in your pantry</string>
