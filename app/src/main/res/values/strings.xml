        <item quantity="one">Matching %1$d pantry ingredient against %2$d recipes</item>
        <item quantity="other">Matching %1$d pantry ingredients against %2$d recipes</item>
    </plurals>

    <string name="heading_ready_count">Ready to cook now (%1$d)</string>
    <string name="heading_almost_count">Almost there — one ingredient short (%1$d)</string>
    <string name="heading_almost_explainer">These are NOT suggestions. Each one still needs a shopping trip.</string>

    <plurals name="suggestion_all_ingredients">
        <item quantity="one">%1$d ingredient, all in your pantry</item>
        <item quantity="other">All %1$d ingredients in your pantry</item>
