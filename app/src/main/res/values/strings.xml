<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Every piece of user-facing text lives here rather than in Java or in a layout.
        That keeps the UI translatable, lets the plurals below pick the right wording for a
        count automatically, and means a wording change is one edit in one file.
    -->

