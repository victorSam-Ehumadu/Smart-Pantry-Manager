    <string name="settings_heading_about">About</string>
    <!-- Two independent counts; a plural can only be keyed on one of them. -->
    <string name="settings_storage_summary" tools:ignore="PluralsCandidate">Stored locally: %1$d pantry items, %2$d recipes</string>
    <string name="settings_about_body">Smart Pantry Manager keeps everything on this device in a SQLite database (%1$s). It requests no permissions, uses no location or mapping services, and works entirely offline.</string>

    <string name="msg_pantry_already_empty">Your pantry is already empty</string>
    <string name="msg_recipes_restored">Recipe book restored</string>

    <plurals name="msg_pantry_cleared">
        <item quantity="one">Removed %1$d ingredient</item>
