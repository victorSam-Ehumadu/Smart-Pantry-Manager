<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback launcher icon for API 24-25, which cannot inflate <adaptive-icon>.
     The basket glyph is inset over the brand colour to mimic the adaptive version. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
</layer-list>
