<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared empty-state block, pulled into three screens with <include>.

    Section 2.2 asks for real feedback instead of a blank screen when nothing matches, and
    every screen needs the same illustration + message + call-to-action arrangement. Keeping
    one copy means they cannot drift apart. The hosting Activity sets the message text and
    decides whether the button is useful.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyState"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:visibility="gone">

    <ImageView
        android:layout_width="@dimen/icon_empty_state"
        android:layout_height="@dimen/icon_empty_state"
        android:alpha="0.35"
        android:contentDescription="@string/cd_empty_illustration"
        android:src="@drawable/ic_basket"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/textEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/text_secondary"
        tools:text="Your pantry is empty."
        xmlns:tools="http://schemas.android.com/tools" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonEmptyAction"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/action_add_ingredient"
        app:icon="@drawable/ic_add" />
</LinearLayout>
