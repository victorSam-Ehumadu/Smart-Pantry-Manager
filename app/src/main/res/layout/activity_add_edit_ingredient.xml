<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen 2: the add / edit form.

    Wrapped in a ScrollView so the form still reaches its Save button on a small screen with
    the keyboard open (the Activity also sets windowSoftInputMode="adjustResize"). Every
    field is a Material TextInputLayout, which is what gives the validation errors from
    AddEditIngredientActivity somewhere to appear without a separate error label per field.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SmartPantry.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <!-- Ingredient name. An AutoCompleteTextView (not a plain EditText) so the names
                 the recipe book uses can be suggested as the user types. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutName"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_name"
                app:helperText="@string/helper_name"
                app:startIconDrawable="@drawable/ic_basket">

                <AutoCompleteTextView
                    android:id="@+id/inputName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    tools:ignore="LabelFor"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords"
                    android:maxLength="60"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Quantity. numberDecimal keeps the keyboard numeric; the Activity still
                     validates the value, because a keyboard hint is not a guarantee. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutQuantity"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/label_quantity">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="9"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Unit. An exposed dropdown menu rather than a free text field, so the
                     stored unit is always one the UnitConverter can actually convert. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutUnit"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:hint="@string/label_unit">

                    <AutoCompleteTextView
                        android:id="@+id/inputUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Expiry date. focusable="false" means taps open the date picker instead of
                 the keyboard, so a malformed date cannot be typed in the first place. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutExpiry"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/label_expiry"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:helperText="@string/helper_expiry_optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:longClickable="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/action_save"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/action_cancel" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
