<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in either suggestions list, inflated by RecipeMatchAdapter.

    The badge is the important part: in the strict list it confirms that all N ingredients
    are covered, and in the Almost There list it names the single missing one. The adapter
    swaps the badge background so the two lists never look alike.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_m"
    android:layout_marginTop="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_m"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            android:id="@+id/textMatchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            tools:text="Leftover Veg Fried Rice" />

        <TextView
            android:id="@+id/textMatchMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_secondary"
            tools:text="Dinner · 20 min · serves 3" />

        <TextView
            android:id="@+id/textMatchBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_badge_ready"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="All 7 ingredients in your pantry" />

        <TextView
            android:id="@+id/textMatchNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="You have 6 of 7 ingredients"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
