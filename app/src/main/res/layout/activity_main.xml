<?xml version="1.0" encoding="utf-8"?>
<!--
    Screen 1: the pantry list.

    A CoordinatorLayout is the root so Snackbars (delete + undo) can be anchored to it and
    are automatically pushed above the floating action button instead of covering it. The
    content itself is a straightforward vertical LinearLayout, and the list sits in a
    FrameLayout stacked with the shared empty state so exactly one of the two is visible.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.SmartPantry.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Expiry warning. Hidden unless something is actually about to go off. -->
        <TextView
            android:id="@+id/textExpiringBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_m"
            android:background="@drawable/bg_banner_warning"
            android:drawablePadding="@dimen/space_s"
            android:gravity="center_vertical"
            android:padding="@dimen/space_m"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/expiring_soon"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="@color/expiring_soon"
            tools:text="2 items expire within 3 days — use them soon"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textPantrySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.SmartPantry.SectionHeading"
            android:visibility="gone"
            tools:text="7 ingredients in your pantry"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPantry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/list_bottom_padding"
                tools:itemCount="4"
                tools:listitem="@layout/item_pantry" />

            <include layout="@layout/view_empty_state" />
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_nav" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginBottom="@dimen/list_bottom_padding"
        android:contentDescription="@string/cd_add_ingredient"
        app:srcCompat="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
